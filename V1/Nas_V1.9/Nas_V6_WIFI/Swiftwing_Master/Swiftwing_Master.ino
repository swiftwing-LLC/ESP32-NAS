}

void handleFanControl() {
  if (!isAuthenticated()) {
    server.send(401, "application/json", "{\"error\":\"unauthorized\"}");
    return;
  }

  if (!isAdminAuthenticated()) {
    server.send(403, "application/json", "{\"error\":\"owner account required\"}");
    return;
  }

  if (!server.hasArg("percent")) {
    server.send(400, "application/json", "{\"error\":\"missing percent\"}");
    return;
  }

  String rawPercent = server.arg("percent");
  rawPercent.trim();
  char* end = nullptr;
  long percent = strtol(rawPercent.c_str(), &end, 10);
  if (rawPercent.length() == 0 || end == rawPercent.c_str() || *end != '\0' || percent < 0 || percent > 100) {
    server.send(400, "application/json", "{\"error\":\"percent must be 0 to 100\"}");
    return;
  }

  if (!monitorOnline || !monitorFanSupported) {
    server.send(409, "application/json", "{\"error\":\"fan-capable ESP32 Monitor is offline\"}");
    return;
  }

  monitorStatusUDP.beginPacket(monitorIP, MONITOR_FAN_CONTROL_PORT);
  monitorStatusUDP.print(String("SWIFTWING_FAN|V1|") + String(percent));
  if (monitorStatusUDP.endPacket() != 1) {
    server.send(502, "application/json", "{\"error\":\"fan command could not be sent\"}");
    return;
  }

  server.sendHeader("Cache-Control", "no-store");
  server.send(202, "application/json", String("{\"ok\":true,\"requested\":") + String(percent) + "}");
}

// =====================================================
// Web Routes
// =====================================================

void handleRoot() {
  if (provisioningMode && WiFi.status() != WL_CONNECTED) {
    server.sendHeader("Cache-Control", "no-store, no-cache, must-revalidate, max-age=0");
    server.sendHeader("Content-Encoding", "gzip");
    server.send_P(200, "text/html; charset=utf-8", (PGM_P)WIFI_SETUP_PAGE, WIFI_SETUP_PAGE_LEN);
    return;
  }

  if (!isAuthenticated()) {
    handleLoginPage();
    return;
  }

  server.sendHeader("Cache-Control", "no-store, no-cache, must-revalidate, max-age=0");
  server.sendHeader("Pragma", "no-cache");
  server.sendHeader("Expires", "0");

  server.sendHeader("Content-Encoding", "gzip");
  server.send_P(
    200,
    "text/html; charset=utf-8",
    (PGM_P)MAIN_PAGE,
    MAIN_PAGE_LEN
  );
}

void handleStatusPage() {
  if (!isAuthenticated()) {
    redirectTo("/");
    return;
  }

  server.sendHeader("Content-Encoding", "gzip");
  server.send_P(
    200,
    "text/html; charset=utf-8",
    (PGM_P)STATUS_PAGE,
    STATUS_PAGE_LEN
  );
}

// =====================================================
// WiFi
// =====================================================

// Managed by the Swiftwing Wi-Fi block near the top of this file.

// =====================================================
// Setup / Loop
// =====================================================

void setup() {
  // The control/UI board does not handle file data. 160 MHz keeps Wi-Fi and
  // the web UI responsive while reducing the CPU's active power from 240 MHz.
  bool cpuClockReduced = setCpuFrequencyMhz(160);
  Serial.begin(115200);

  if (!cpuClockReduced) {
    Serial.println("Master CPU clock reduction unavailable; using board default");
  }

  delay(500);
  connectWiFi();

  wifiSyncUDP.begin(WIFI_SYNC_LOCAL_PORT);

  storageUDP.begin(
    STORAGE_DISCOVERY_PORT
  );

  masterAnnounceUDP.begin(
    MASTER_LOCAL_PORT
  );

  dnsStatusUDP.begin(
    DNS_STATUS_PORT
  );

  monitorStatusUDP.begin(
    MONITOR_STATUS_PORT
  );

  const char* headerKeys[] = {
    "Cookie"
  };

  server.collectHeaders(
    headerKeys,
    1
  );

  server.on(
    "/",
    HTTP_GET,
    handleRoot
  );

  server.on(
    "/status",
    HTTP_GET,
    handleStatusPage
  );

  server.on(
    "/api/state",
    HTTP_GET,
    handleState
  );

  server.on(
    "/api/fan",
    HTTP_POST,
    handleFanControl
  );

  server.on(
    "/login",
    HTTP_GET,
    handleLoginPage
  );

  server.on(
    "/login",
    HTTP_POST,
    handleLogin
  );

  server.on(
    "/register",
    HTTP_POST,
    handleRegister
  );

  server.on(
    "/api/accounts",
    HTTP_GET,
    handleAccounts
  );

  server.on(
    "/api/accounts/review",
    HTTP_POST,
    handleAccountReview
  );

  server.on(
    "/logout",
    HTTP_GET,
    handleLogout
  );

  server.on(
    "/ui-version",
    HTTP_GET,
    []() {
      server.sendHeader("Cache-Control", "no-store, no-cache, must-revalidate, max-age=0");
      server.send(200, "text/plain; charset=utf-8", UI_BUILD);
    }
  );

  server.on(
    "/wifi",
    HTTP_GET,
    []() {
      if (!wifiAdminAllowed()) { redirectTo("/"); return; }
      server.sendHeader("Cache-Control", "no-store, no-cache, must-revalidate, max-age=0");
      server.sendHeader("Content-Encoding", "gzip");
      server.send_P(200, "text/html; charset=utf-8", (PGM_P)WIFI_SETUP_PAGE, WIFI_SETUP_PAGE_LEN);
    }
  );

  server.on(
    "/api/wifi/status",
    HTTP_GET,
    handleWiFiStatus
  );

  server.on(
    "/api/wifi/scan",
    HTTP_GET,
    handleWiFiScan
  );

  server.on(
    "/api/wifi/apply",
    HTTP_POST,
    handleWiFiApply
  );

  server.on(
    "/api/wifi/bootstrap",
    HTTP_GET,
    handleWiFiBootstrap
  );

  server.onNotFound(
    []() {
      if (!isAuthenticated()) {
        redirectTo("/");
        return;
      }

      server.send(
        404,
        "text/plain",
        "Not found"
      );
    }
  );

  server.begin();

  sendStorageDiscovery();

  sendMasterAnnouncement();

  lastDiscovery =
    millis();

  lastMasterAnnouncement =
    millis();

  Serial.println(
    "Swiftwing Master V1.3 ONLINE"
  );

  Serial.print(
    "Files: http://"
  );

  Serial.println(
    WiFi.localIP()
  );

  Serial.print(
    "Status: http://"
  );

  Serial.print(
    WiFi.localIP()
  );

  Serial.println(
    "/status"
  );
}

void loop() {
  server.handleClient();

  processMasterDiscoveryRequests();
  processStorageReplies();

  processDNSStatus();

  processMonitorStatus();

  maintainMasterWiFi();

  if (wifiRestartAt && (long)(millis() - wifiRestartAt) >= 0) {
    ESP.restart();
  }

  unsigned long now =
    millis();

  if (
    now - lastDiscovery >=
    DISCOVERY_INTERVAL_MS
  ) {
    lastDiscovery =
      now;

    sendStorageDiscovery();
  }

  if (
    now - lastMasterAnnouncement >=
    MASTER_ANNOUNCE_MS
  ) {
    lastMasterAnnouncement =
      now;

    sendMasterAnnouncement();
  }

  // Give the Wi-Fi task more idle time while keeping UI/UDP polling responsive.
  delay(5);
}
