// Discovery
// =====================================================

void sendStorageDiscovery() {
  storageUDP.beginPacket(
    IPAddress(255, 255, 255, 255),
    STORAGE_DISCOVERY_PORT
  );

  storageUDP.print(
    "SWIFTWING_DISCOVER|MASTER"
  );

  storageUDP.endPacket();
}

void processStorageReplies() {
  int packetSize = storageUDP.parsePacket();

  while (packetSize) {
    char buffer[256];

    int len = storageUDP.read(
      buffer,
      sizeof(buffer) - 1
    );

    if (len > 0) {
      buffer[len] = '\0';
    }

    String msg(buffer);

    // SWIFTWING_STORAGE|NODE1|ip|port|ready|total|used|free|uptime
    if (msg.startsWith("SWIFTWING_STORAGE|")) {
      String id = fieldAt(msg, 1);

      IPAddress reportedIP;

      if (!parseIPv4(fieldAt(msg, 2), reportedIP)) {
        reportedIP = storageUDP.remoteIP();
      }

      uint16_t port = (uint16_t)fieldAt(msg, 3).toInt();
      if (port == 0) {
        port = 80;
      }

      bool storageReady = fieldAt(msg, 4).toInt() == 1;

      uint64_t totalBytes = strtoull(
        fieldAt(msg, 5).c_str(),
        nullptr,
        10
      );

      uint64_t usedBytes = strtoull(
        fieldAt(msg, 6).c_str(),
        nullptr,
        10
      );

      uint64_t freeBytes = strtoull(
        fieldAt(msg, 7).c_str(),
        nullptr,
        10
      );

      uint32_t uptimeSeconds =
        fieldAt(msg, 8).toInt();

      if (id == "NODE1") {
        node1IP = reportedIP;
        node1Port = port;
        node1StorageReady = storageReady;
        node1TotalBytes = totalBytes;
        node1UsedBytes = usedBytes;
        node1FreeBytes = freeBytes;
        node1UptimeSeconds = uptimeSeconds;
        node1LastSeen = millis();
        node1Online = true;
      }

      else if (id == "NODE2") {
        node2IP = reportedIP;
        node2Port = port;
        node2StorageReady = storageReady;
        node2TotalBytes = totalBytes;
        node2UsedBytes = usedBytes;
        node2FreeBytes = freeBytes;
        node2UptimeSeconds = uptimeSeconds;
        node2LastSeen = millis();
        node2Online = true;
      }
    }

    packetSize = storageUDP.parsePacket();
  }

  unsigned long now = millis();

  if (
    node1Online &&
    now - node1LastSeen > NODE_TIMEOUT_MS
  ) {
    node1Online = false;
  }

  if (
    node2Online &&
    now - node2LastSeen > NODE_TIMEOUT_MS
  ) {
    node2Online = false;
  }
}

IPAddress subnetBroadcastIP() {
  IPAddress ip = WiFi.localIP();
  IPAddress mask = WiFi.subnetMask();

  return IPAddress(
    ip[0] | (uint8_t)(~mask[0]),
    ip[1] | (uint8_t)(~mask[1]),
    ip[2] | (uint8_t)(~mask[2]),
    ip[3] | (uint8_t)(~mask[3])
  );
}

void sendMasterAnnouncementTo(
  IPAddress targetIP,
  uint16_t targetPort
) {
  String msg =
    "SWIFTWING_MASTER|" +
    WiFi.localIP().toString() +
    "|" +
    String(millis() / 1000UL);

  masterAnnounceUDP.beginPacket(
    targetIP,
    targetPort
  );

  masterAnnounceUDP.print(msg);
  masterAnnounceUDP.endPacket();
}

void sendMasterAnnouncement() {
  if (
    WiFi.status() !=
    WL_CONNECTED
  ) {
    return;
  }

  // Traditional limited broadcast.
  sendMasterAnnouncementTo(
    IPAddress(255, 255, 255, 255),
    MASTER_ANNOUNCE_PORT
  );

  // Subnet-directed broadcast, e.g. 192.168.0.255.
  IPAddress subnetBroadcast =
    subnetBroadcastIP();

  if (
    subnetBroadcast !=
    IPAddress(255, 255, 255, 255)
  ) {
    sendMasterAnnouncementTo(
      subnetBroadcast,
      MASTER_ANNOUNCE_PORT
    );
  }
}

void processMasterDiscoveryRequests() {
  int packetSize =
    masterAnnounceUDP.parsePacket();

  while (packetSize) {
    char buffer[160];

    int len =
      masterAnnounceUDP.read(
        buffer,
        sizeof(buffer) - 1
      );

    if (len > 0) {
      buffer[len] = '\0';
    }

    String msg(buffer);

    if (
      msg.startsWith(
        "SWIFTWING_FIND_MASTER|"
      )
    ) {
      // Reply directly to the requesting device.
      sendMasterAnnouncementTo(
        masterAnnounceUDP.remoteIP(),
        masterAnnounceUDP.remotePort()
      );

      Serial.print(
        "Master discovery reply -> "
      );
      Serial.print(
        masterAnnounceUDP.remoteIP()
      );
      Serial.print(":");
      Serial.println(
        masterAnnounceUDP.remotePort()
      );
    }

    packetSize =
      masterAnnounceUDP.parsePacket();
  }
}

void processDNSStatus() {
  int packetSize =
    dnsStatusUDP.parsePacket();

  while (packetSize) {
    char buffer[160];

    int len =
      dnsStatusUDP.read(
        buffer,
        sizeof(buffer) - 1
      );

    if (len > 0) {
      buffer[len] = '\0';
    }

    String msg(buffer);

    if (
      msg.startsWith(
        "SWIFTWING_DNS|C3|"
      )
    ) {
      IPAddress ip;

      if (
        parseIPv4(
          fieldAt(msg, 2),
          ip
        )
      ) {
        c3IP = ip;
      } else {
        c3IP =
          dnsStatusUDP.remoteIP();
      }

      c3Uptime =
        fieldAt(msg, 3).toInt();

      c3LastSeen =
        millis();

      c3Online =
        true;
    }

    packetSize =
      dnsStatusUDP.parsePacket();
  }

  if (
    c3Online &&
    millis() - c3LastSeen >
    SERVICE_TIMEOUT_MS
  ) {
    c3Online = false;
  }
}

