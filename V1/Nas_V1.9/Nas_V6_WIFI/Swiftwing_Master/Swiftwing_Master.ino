unsigned long lastReconnectAttempt = 0;

String hexEncode(const String &text) {
  const char *hex = "0123456789ABCDEF";
  String out;
  out.reserve(text.length() * 2);

  for (unsigned int i = 0; i < text.length(); i++) {
    uint8_t c = (uint8_t)text[i];
    out += hex[(c >> 4) & 0x0F];
    out += hex[c & 0x0F];
  }

  return out;
}

bool loadMasterWiFi() {
  wifiPrefs.begin("swiftwifi", true);
  configuredSSID = wifiPrefs.getString("ssid", "");
  configuredPass = wifiPrefs.getString("pass", "");
  wifiPrefs.end();
  return configuredSSID.length() > 0;
}

void saveMasterWiFi(const String &ssid, const String &pass) {
  wifiPrefs.begin("swiftwifi", false);
  wifiPrefs.putString("ssid", ssid);
  wifiPrefs.putString("pass", pass);
  wifiPrefs.end();
  configuredSSID = ssid;
  configuredPass = pass;
}

bool waitForMasterWiFi(unsigned long timeoutMs) {
  unsigned long start = millis();
  while (WiFi.status() != WL_CONNECTED && millis() - start < timeoutMs) {
    delay(250);
  }
  return WiFi.status() == WL_CONNECTED;
}

void startSwiftwingBridge() {
  WiFi.mode(WIFI_AP_STA);
  WiFi.setSleep(false);

  if (!WiFi.softAP(SWIFTWING_SETUP_SSID, SWIFTWING_SETUP_PASS, 1, 0, 8)) {
    Serial.println("Swiftwing-Bridge AP start failed");
  } else {
    Serial.print("Swiftwing-Bridge: ");
    Serial.println(WiFi.softAPIP());
  }
}

void connectWiFi() {
  startSwiftwingBridge();

  bool connected = false;
  bool hadSaved = loadMasterWiFi();

  // First try the saved network, if there is one.
  if (hadSaved) {
    Serial.print("Connecting saved WiFi: ");
    Serial.println(configuredSSID);

    WiFi.begin(
      configuredSSID.c_str(),
      configuredPass.c_str()
    );

    connected = waitForMasterWiFi(8000);
  }

  // Always keep the known home WiFi as a built-in fallback.
  // This makes reflashing/NVS changes much less fragile.
  if (!connected) {
    Serial.print("Trying built-in home WiFi: ");
    Serial.println(DEFAULT_WIFI_SSID);

    WiFi.disconnect();
    delay(150);

    configuredSSID = DEFAULT_WIFI_SSID;
    configuredPass = DEFAULT_WIFI_PASSWORD;

    WiFi.begin(
      DEFAULT_WIFI_SSID,
      DEFAULT_WIFI_PASSWORD
    );

    connected = waitForMasterWiFi(12000);

    if (connected) {
      saveMasterWiFi(
        DEFAULT_WIFI_SSID,
        DEFAULT_WIFI_PASSWORD
      );
    }
  }

  provisioningMode = !connected;

  if (connected) {
    Serial.print("Master WiFi: ");
    Serial.println(WiFi.SSID());
    Serial.print("Master IP: ");
    Serial.println(WiFi.localIP());
  } else {
    Serial.println("Home WiFi not connected.");
    Serial.println("Open http://192.168.4.1 and choose WiFi.");
  }
}

void maintainMasterWiFi() {
  if (WiFi.status() == WL_CONNECTED) {
    provisioningMode = false;
    return;
  }

  if (configuredSSID.length() == 0) {
    provisioningMode = true;
    return;
  }

  unsigned long now = millis();
  if (now - lastReconnectAttempt < 10000) return;

  lastReconnectAttempt = now;
  WiFi.begin(configuredSSID.c_str(), configuredPass.c_str());
}

void sendWiFiPacketTo(IPAddress target, const String &packet) {
  wifiSyncUDP.beginPacket(target, WIFI_SYNC_PORT);
  wifiSyncUDP.print(packet);
  wifiSyncUDP.endPacket();
}

void broadcastWiFiConfig(const String &ssid, const String &pass) {
  String packet =
    String("SWIFTWING_WIFI|") +
    WIFI_SYNC_KEY + "|" +
    hexEncode(ssid) + "|" +
    hexEncode(pass);

  // Send several times so Node1 / Node2 / C3 / Monitor all have a chance to receive it.
  for (int i = 0; i < 5; i++) {
    sendWiFiPacketTo(IPAddress(255, 255, 255, 255), packet);
    sendWiFiPacketTo(IPAddress(192, 168, 4, 255), packet);
    delay(80);
  }
}

bool wifiAdminAllowed() {
  return provisioningMode || isAdminAuthenticated();
}

void handleWiFiStatus() {
  if (!wifiAdminAllowed()) {
    server.send(401, "application/json", "{\"error\":\"unauthorized\"}");
    return;
  }

  String json = "{";
  json += "\"connected\":" + String(WiFi.status() == WL_CONNECTED ? "true" : "false") + ",";
  json += "\"ssid\":\"" + jsonEscape(WiFi.status() == WL_CONNECTED ? WiFi.SSID() : String("")) + "\",";
  json += "\"ip\":\"" + (WiFi.status() == WL_CONNECTED ? WiFi.localIP().toString() : String("")) + "\",";
  json += "\"rssi\":" + String(WiFi.status() == WL_CONNECTED ? WiFi.RSSI() : 0) + ",";
  json += "\"bridgeIp\":\"" + WiFi.softAPIP().toString() + "\"";
  json += "}";

  server.sendHeader("Cache-Control", "no-store");
  server.send(200, "application/json", json);
}

void handleWiFiScan() {
  if (!wifiAdminAllowed()) {
    server.send(401, "application/json", "{\"error\":\"unauthorized\"}");
    return;
  }

  int n = WiFi.scanNetworks(false, true);
  String json = "{\"networks\":[";
  bool first = true;

  for (int i = 0; i < n; i++) {
    String ssid = WiFi.SSID(i);
    if (ssid.length() == 0) continue;

    if (!first) json += ",";
    first = false;

    json += "{";
    json += "\"ssid\":\"" + jsonEscape(ssid) + "\",";
    json += "\"rssi\":" + String(WiFi.RSSI(i)) + ",";
    json += "\"open\":" + String(WiFi.encryptionType(i) == WIFI_AUTH_OPEN ? "true" : "false");
    json += "}";
  }

  json += "]}";
  WiFi.scanDelete();

  server.sendHeader("Cache-Control", "no-store");
  server.send(200, "application/json", json);
}

void handleWiFiApply() {
  if (!wifiAdminAllowed()) {
    server.send(401, "application/json", "{\"error\":\"unauthorized\"}");
    return;
  }

  if (!server.hasArg("ssid") || !server.hasArg("password")) {
    server.send(400, "application/json", "{\"error\":\"missing fields\"}");
    return;
  }

  String ssid = server.arg("ssid");
  String pass = server.arg("password");
  ssid.trim();

  if (ssid.length() == 0 || ssid.length() > 32 || pass.length() > 64) {
    server.send(400, "application/json", "{\"error\":\"invalid WiFi credentials\"}");
    return;
  }

  // Other four boards receive and save the new Wi-Fi first.
  broadcastWiFiConfig(ssid, pass);
  saveMasterWiFi(ssid, pass);

  server.send(
    200,
    "application/json",
    "{\"ok\":true,\"message\":\"Saved. All five boards are restarting onto the selected WiFi.\"}"
  );

  wifiRestartAt = millis() + 2200;
}



// =====================================================
// Child-board Wi-Fi bootstrap over Swiftwing-Bridge
// =====================================================

void handleWiFiBootstrap() {
  if (!server.hasArg("key") || server.arg("key") != WIFI_SYNC_KEY) {
    server.send(403, "text/plain", "Forbidden");
    return;
  }

  if (configuredSSID.length() == 0) {
    loadMasterWiFi();
  }

  if (configuredSSID.length() == 0) {
    server.send(503, "text/plain", "WiFi not configured yet");
    return;
  }

  String body =
    String("SWIFTWING_BOOTSTRAP|") +
    hexEncode(configuredSSID) + "|" +
    hexEncode(configuredPass);

  server.sendHeader("Cache-Control", "no-store");
  server.send(200, "text/plain", body);
}

