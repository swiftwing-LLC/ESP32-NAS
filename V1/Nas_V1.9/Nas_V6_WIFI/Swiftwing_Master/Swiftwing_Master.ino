void handleLogin() {
  if (
    !server.hasArg("username") ||
    !server.hasArg("password")
  ) {
    server.send(
      400,
      "text/plain",
      "Missing credentials"
    );

    return;
  }

  String username = normalizeUsername(server.arg("username"));
  String password = server.arg("password");
  String adminUsername = normalizeUsername(String(UI_USERNAME));
  bool authenticated = false;
  bool isAdmin = false;

  if (username == adminUsername && password == UI_PASSWORD) {
    authenticated = true;
    isAdmin = true;
  } else {
    StoredNasUser account;
    int accountSlot = findStoredNasUser(username, account);
    if (
      accountSlot >= 0 &&
      passwordMatches(password, account.saltHex, account.passwordHashHex)
    ) {
      if (account.status == "pending") {
        server.send(
          403,
          "text/plain; charset=utf-8",
          "Your account request is waiting for owner approval."
        );
        return;
      }
      authenticated = account.status == "active";
    }
  }

  if (!authenticated) {
    server.send(
      401,
      "text/plain; charset=utf-8",
      "Invalid username or password"
    );

    return;
  }

  String newSessionToken = createSession(username, isAdmin);

  server.sendHeader(
    "Set-Cookie",
    "SWIFTWING_SESSION=" +
    newSessionToken +
    "; Path=/; HttpOnly; SameSite=Lax"
  );

  redirectTo("/");
}

void sendAccountResponse(int statusCode, bool ok, const String &message) {
  String json = "{\"ok\":";
  json += ok ? "true" : "false";
  json += ",\"message\":\"" + jsonEscape(message) + "\"}";
  server.sendHeader("Cache-Control", "no-store");
  server.send(statusCode, "application/json; charset=utf-8", json);
}

void handleRegister() {
  if (
    !server.hasArg("username") ||
    !server.hasArg("password") ||
    !server.hasArg("confirmPassword")
  ) {
    sendAccountResponse(400, false, "Complete all account fields.");
    return;
  }

  String username = normalizeUsername(server.arg("username"));
  String password = server.arg("password");
  String confirmPassword = server.arg("confirmPassword");

  if (!validUsername(username)) {
    sendAccountResponse(400, false, "Use 3–24 letters, numbers, dots, hyphens, or underscores.");
    return;
  }

  if (username == normalizeUsername(String(UI_USERNAME))) {
    sendAccountResponse(409, false, "That username is reserved for the NAS owner.");
    return;
  }

  if (password.length() < 8 || password.length() > 64) {
    sendAccountResponse(400, false, "Choose a password between 8 and 64 characters.");
    return;
  }

  if (password != confirmPassword) {
    sendAccountResponse(400, false, "The passwords do not match.");
    return;
  }

  StoredNasUser existing;
  if (findStoredNasUser(username, existing) >= 0) {
    sendAccountResponse(409, false, "That username is already in use.");
    return;
  }

  if (countNasUsersWithStatus("pending") >= MAX_PENDING_NAS_USERS) {
    sendAccountResponse(409, false, "The approval queue is full. Please contact the NAS owner.");
    return;
  }

  int slot = findFreeNasUserSlot();
  if (slot < 0) {
    sendAccountResponse(409, false, "The NAS has reached its user account limit.");
    return;
  }

  StoredNasUser account;
  account.username = username;
  account.status = "pending";
  account.saltHex = makeRandomSaltHex();
  account.valid = derivePasswordHash(password, account.saltHex, account.passwordHashHex);
  if (!account.valid) {
    sendAccountResponse(500, false, "Could not secure the password. Please try again.");
    return;
  }

  if (!saveStoredNasUser(slot, account)) {
    sendAccountResponse(500, false, "Could not create the account. Please try again.");
    return;
  }

  sendAccountResponse(202, true, "Request submitted. You can sign in after the NAS owner approves it.");
}

void handleAccounts() {
  if (!isAdminAuthenticated()) {
    sendAccountResponse(403, false, "Owner access required.");
    return;
  }

  String json;
  json.reserve(1200);
  json = "{\"pending\":[";
  bool firstPending = true;
  for (int slot = 0; slot < MAX_NAS_USERS; slot++) {
    StoredNasUser account;
    if (!loadStoredNasUser(slot, account) || account.status != "pending") continue;
    if (!firstPending) json += ",";
    json += "{\"username\":\"" + jsonEscape(account.username) + "\"}";
    firstPending = false;
  }
  json += "],\"users\":[";
  bool firstActive = true;
  for (int slot = 0; slot < MAX_NAS_USERS; slot++) {
    StoredNasUser account;
    if (!loadStoredNasUser(slot, account) || account.status != "active") continue;
    if (!firstActive) json += ",";
    json += "{\"username\":\"" + jsonEscape(account.username) + "\"}";
    firstActive = false;
  }
  json += "]}";

  server.sendHeader("Cache-Control", "no-store");
  server.send(200, "application/json; charset=utf-8", json);
}

void handleAccountReview() {
  if (!isAdminAuthenticated()) {
    sendAccountResponse(403, false, "Owner access required.");
    return;
  }

  if (!server.hasArg("username") || !server.hasArg("action")) {
    sendAccountResponse(400, false, "Missing account or action.");
    return;
  }

  String username = normalizeUsername(server.arg("username"));
  String action = server.arg("action");
  StoredNasUser account;
  int slot = findStoredNasUser(username, account);
  if (slot < 0) {
    sendAccountResponse(404, false, "User account was not found.");
    return;
  }

  if (action == "approve") {
    if (account.status != "pending") {
      sendAccountResponse(409, false, "Only pending requests can be approved.");
      return;
    }
    account.status = "active";
    if (!saveStoredNasUser(slot, account)) {
      sendAccountResponse(500, false, "Could not approve this account request.");
      return;
    }
    sendAccountResponse(200, true, "Account approved. The user can now sign in.");
    return;
  }

  if (action == "reject") {
    if (account.status != "pending") {
      sendAccountResponse(409, false, "Only pending requests can be rejected.");
      return;
    }
    clearSessionsForUser(username);
    if (!removeStoredNasUser(slot)) {
      sendAccountResponse(500, false, "Could not reject this account request.");
      return;
    }
    sendAccountResponse(200, true, "Request rejected and removed.");
    return;
  }

  if (action != "revoke" || account.status != "active") {
    sendAccountResponse(400, false, "Choose approve, reject or revoke for the selected account.");
    return;
  }

  clearSessionsForUser(username);
  if (!removeStoredNasUser(slot)) {
    sendAccountResponse(500, false, "Could not remove this account.");
    return;
  }
  sendAccountResponse(200, true, "Account access revoked.");
}

void handleLogout() {
  removeCurrentSession();

  server.sendHeader(
    "Set-Cookie",
    "SWIFTWING_SESSION=deleted; Path=/; Max-Age=0; HttpOnly; SameSite=Lax"
  );

  redirectTo("/");
}

