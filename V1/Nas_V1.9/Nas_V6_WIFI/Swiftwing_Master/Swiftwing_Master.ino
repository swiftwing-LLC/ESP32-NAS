    return;
  }

  String json;
  json.reserve(1600);

  json = "{";

  json +=
    "\"currentUser\":\"" +
    jsonEscape(sessions[sessionSlot].username) +
    "\",";

  json +=
    "\"isAdmin\":" +
    String(sessions[sessionSlot].isAdmin ? "true" : "false") +
    ",";

  json +=
    "\"apiKey\":\"" +
    jsonEscape(
      String(NODE_API_KEY)
    ) +
    "\",";

  json +=
