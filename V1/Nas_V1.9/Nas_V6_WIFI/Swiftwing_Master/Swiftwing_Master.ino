    node2Json();

  json += "},";

  json +=
    "\"services\":{";

  json +=
    "\"master\":{";

  json +=
    "\"label\":\"Master\",";

  json +=
    "\"detail\":\"Control / UI\",";

  json +=
    "\"online\":true,";

  json +=
    "\"ip\":\"" +
    WiFi.localIP().toString() +
    "\",";

  json +=
    "\"uptime\":" +
    String(
      millis() / 1000UL
    );

  json += "},";

  json +=
    "\"dns\":{";

  json +=
    "\"label\":\"C3 DNS\",";

