// =====================================================
// Helpers
// =====================================================

String jsonEscape(String s) {
  s.replace("\\", "\\\\");
  s.replace("\"", "\\\"");
  s.replace("\r", "\\r");
  s.replace("\n", "\\n");
  return s;
}

String uint64ToString(uint64_t value) {
  char buf[32];

  snprintf(
    buf,
    sizeof(buf),
    "%llu",
    (unsigned long long)value
  );

  return String(buf);
}

String fieldAt(const String &s, int index) {
  int start = 0;
  int current = 0;

  while (true) {
    int end = s.indexOf('|', start);

    if (current == index) {
      if (end < 0) return s.substring(start);
      return s.substring(start, end);
    }

    if (end < 0) return "";

    start = end + 1;
    current++;
  }
}

String normalizeUsername(String username) {
  username.trim();
  username.toLowerCase();
  return username;
}

bool validUsername(const String &username) {
  if (username.length() < 3 || username.length() > 24) return false;

  for (size_t i = 0; i < username.length(); i++) {
    char c = username[i];
    bool alpha = c >= 'a' && c <= 'z';
    bool digit = c >= '0' && c <= '9';
    bool mark = c == '_' || c == '-' || c == '.';
    if (!alpha && !digit && !mark) return false;
    if (i == 0 && !alpha && !digit) return false;
  }

  return true;
}

bool isHexString(const String &value, size_t expectedLength) {
  if (value.length() != expectedLength) return false;
  for (size_t i = 0; i < value.length(); i++) {
    char c = value[i];
    if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'))) return false;
  }
  return true;
}

bool hexToBytes(const String &hex, uint8_t *bytes, size_t byteCount) {
  if (!isHexString(hex, byteCount * 2)) return false;
  for (size_t i = 0; i < byteCount; i++) {
    char pair[3] = {hex[i * 2], hex[i * 2 + 1], '\0'};
    bytes[i] = (uint8_t)strtoul(pair, nullptr, 16);
  }
  return true;
}

String bytesToHex(const uint8_t *bytes, size_t byteCount) {
  static const char HEX_DIGITS[] = "0123456789abcdef";
  String result;
  result.reserve(byteCount * 2);
  for (size_t i = 0; i < byteCount; i++) {
    result += HEX_DIGITS[(bytes[i] >> 4) & 0x0F];
    result += HEX_DIGITS[bytes[i] & 0x0F];
  }
  return result;
}

String makeRandomSaltHex() {
  uint8_t salt[16];
  for (size_t i = 0; i < sizeof(salt); i++) {
    salt[i] = (uint8_t)(esp_random() & 0xFF);
  }
  String result = bytesToHex(salt, sizeof(salt));
  memset(salt, 0, sizeof(salt));
  return result;
}

bool derivePasswordHash(
  const String &password,
  const String &saltHex,
  String &hashHex
) {
  uint8_t salt[16];
  uint8_t derived[32];
  if (!hexToBytes(saltHex, salt, sizeof(salt))) return false;

  int result = mbedtls_pkcs5_pbkdf2_hmac_ext(
    MBEDTLS_MD_SHA256,
    (const unsigned char*)password.c_str(),
    password.length(),
    salt,
    sizeof(salt),
    USER_PASSWORD_ITERATIONS,
    sizeof(derived),
    derived
  );

  if (result == 0) hashHex = bytesToHex(derived, sizeof(derived));
  memset(salt, 0, sizeof(salt));
  memset(derived, 0, sizeof(derived));
  return result == 0;
}

bool passwordMatches(const String &password, const String &saltHex, const String &expectedHex) {
  if (!isHexString(expectedHex, 64)) return false;
  String actualHex;
  if (!derivePasswordHash(password, saltHex, actualHex)) return false;

  uint8_t diff = 0;
  for (size_t i = 0; i < expectedHex.length(); i++) {
    diff |= (uint8_t)(expectedHex[i] ^ actualHex[i]);
  }
  return diff == 0;
}

String nasUserKey(int slot) {
  return "u" + String(slot);
}

bool loadStoredNasUser(int slot, StoredNasUser &user) {
  user.valid = false;
  if (slot < 0 || slot >= MAX_NAS_USERS) return false;
  if (!userPrefs.begin("swusers", true)) return false;

  String key = nasUserKey(slot);
  String record = userPrefs.getString(key.c_str(), "");
  userPrefs.end();
  if (record.length() == 0) return false;

  user.username = fieldAt(record, 2);
  user.status = fieldAt(record, 1);
  user.saltHex = fieldAt(record, 3);
  user.passwordHashHex = fieldAt(record, 4);
  if (
    fieldAt(record, 0) != "U1" ||
    (user.status != "pending" && user.status != "active") ||
    !validUsername(user.username) ||
    !isHexString(user.saltHex, 32) ||
    !isHexString(user.passwordHashHex, 64) ||
    fieldAt(record, 5).length() > 0
  ) {
    return false;
  }

  user.valid = true;
  return true;
}

bool saveStoredNasUser(int slot, const StoredNasUser &user) {
  if (slot < 0 || slot >= MAX_NAS_USERS || !user.valid) return false;
  if (!userPrefs.begin("swusers", false)) return false;

  String key = nasUserKey(slot);
  String record = "U1|" + user.status + "|" + user.username + "|" +
                  user.saltHex + "|" + user.passwordHashHex;
  size_t written = userPrefs.putString(key.c_str(), record);
  userPrefs.end();
  return written > 0;
}

bool removeStoredNasUser(int slot) {
  if (slot < 0 || slot >= MAX_NAS_USERS) return false;
  if (!userPrefs.begin("swusers", false)) return false;
  String key = nasUserKey(slot);
  bool removed = userPrefs.remove(key.c_str());
  userPrefs.end();
  return removed;
}

int findStoredNasUser(const String &username, StoredNasUser &user) {
  for (int slot = 0; slot < MAX_NAS_USERS; slot++) {
    StoredNasUser candidate;
    if (loadStoredNasUser(slot, candidate) && candidate.username == username) {
      user = candidate;
      return slot;
    }
  }
  return -1;
}

int findFreeNasUserSlot() {
  for (int slot = 0; slot < MAX_NAS_USERS; slot++) {
    StoredNasUser candidate;
    if (!loadStoredNasUser(slot, candidate)) return slot;
  }
  return -1;
}

uint8_t countNasUsersWithStatus(const String &status) {
  uint8_t count = 0;
  for (int slot = 0; slot < MAX_NAS_USERS; slot++) {
    StoredNasUser user;
    if (loadStoredNasUser(slot, user) && user.status == status) count++;
  }
  return count;
}

bool parseIPv4(const String &text, IPAddress &result) {
  int a, b, c, d;

  if (
    sscanf(
      text.c_str(),
      "%d.%d.%d.%d",
      &a,
      &b,
      &c,
      &d
    ) != 4
  ) {
    return false;
  }

  if (
    a < 0 || a > 255 ||
    b < 0 || b > 255 ||
    c < 0 || c > 255 ||
    d < 0 || d > 255
  ) {
    return false;
  }

  result = IPAddress(a, b, c, d);
  return true;
}

// =====================================================
// Authentication
// =====================================================

String getRequestSessionToken() {
  String cookie = server.header("Cookie");
  const String key = "SWIFTWING_SESSION=";

  int start = cookie.indexOf(key);
  if (start < 0) {
    return "";
  }

  start += key.length();

  int end = cookie.indexOf(';', start);
  if (end < 0) {
    end = cookie.length();
  }

  String token = cookie.substring(start, end);
  token.trim();
  return token;
}

int findSessionSlot(const String &token) {
  if (token.length() == 0) {
    return -1;
  }

  for (int i = 0; i < MAX_SESSIONS; i++) {
    if (
      sessions[i].token.length() > 0 &&
      sessions[i].token == token
    ) {
      return i;
    }
  }

  return -1;
}

bool isAuthenticated() {
  return currentSessionSlot() >= 0;
}

int currentSessionSlot() {
  String token = getRequestSessionToken();
  int slot = findSessionSlot(token);
  if (slot >= 0) sessions[slot].lastSeen = millis();
  return slot;
}

bool isAdminAuthenticated() {
  int slot = currentSessionSlot();
  return slot >= 0 && sessions[slot].isAdmin;
}

String makeSessionToken() {
  char buf[33];

  snprintf(
    buf,
    sizeof(buf),
    "%08lx%08lx%08lx%08lx",
    (unsigned long)esp_random(),
    (unsigned long)esp_random(),
    (unsigned long)esp_random(),
    (unsigned long)esp_random()
  );

  return String(buf);
}

int allocateSessionSlot() {
  // Prefer a free slot first.
  for (int i = 0; i < MAX_SESSIONS; i++) {
    if (sessions[i].token.length() == 0) {
      return i;
    }
  }

  // If all 8 slots are occupied, replace the least recently used session.
  int oldestSlot = 0;
  unsigned long oldestSeen = sessions[0].lastSeen;

  for (int i = 1; i < MAX_SESSIONS; i++) {
    if ((long)(sessions[i].lastSeen - oldestSeen) < 0) {
      oldestSeen = sessions[i].lastSeen;
      oldestSlot = i;
    }
  }

  return oldestSlot;
}

String createSession(const String &username, bool isAdmin) {
  int slot = allocateSessionSlot();

  sessions[slot].token = makeSessionToken();
  sessions[slot].username = username;
  sessions[slot].isAdmin = isAdmin;
  sessions[slot].lastSeen = millis();

  return sessions[slot].token;
}

void clearSessionsForUser(const String &username) {
  for (int i = 0; i < MAX_SESSIONS; i++) {
    if (sessions[i].username == username && sessions[i].token.length() > 0) {
      sessions[i].token = "";
      sessions[i].username = "";
      sessions[i].isAdmin = false;
      sessions[i].lastSeen = 0;
    }
  }
}

void removeCurrentSession() {
  String token = getRequestSessionToken();
  int slot = findSessionSlot(token);

  if (slot >= 0) {
    sessions[slot].token = "";
    sessions[slot].username = "";
    sessions[slot].isAdmin = false;
    sessions[slot].lastSeen = 0;
  }
}

void redirectTo(const String &location) {
  server.sendHeader("Location", location);
  server.send(303, "text/plain", "");
}

